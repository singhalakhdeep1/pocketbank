    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@reduxjs/toolkit": "^2.13.0",
    "@stripe/stripe-react-native": "0.81.0",
    "@types/react": "~19.3.0",
    "ethers": "^6.17.0",
    "expo": "^58.0.16",
    "expo-camera": "~58.0.11",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
