# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pocketbank

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4001
NODE_ENV=development
CORS_ORIGINS=http://localhost:8081,exp://192.168.1.x:8081

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-min-32-chars-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
DATA_ENCRYPTION_KEY=change-me-32-byte-hex-key-here!!

# ── Redis (optional — in-memory cache fallback used when unset) ───────────────
REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
CACHE_TTL_SECONDS=3600

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_BUCKET_CAPACITY=100
RATE_LIMIT_REFILL_RATE=1
RATE_LIMIT_AUTH_CAPACITY=10
RATE_LIMIT_AUTH_REFILL_RATE=0.1

# ── Stripe card top-ups (optional) ───────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Point at stripe-mock in local dev:
# STRIPE_API_BASE=http://localhost:12111

# ── Market data (optional — simulated fallback used when unset) ───────────────
ALPHA_VANTAGE_KEY=
COINBASE_API_URL=https://api.coinbase.com

# ── FX rates (optional — hardcoded fallback table used when unset) ────────────
FX_API_URL=https://api.frankfurter.dev/v1

# ── Ethereum on-chain wallets (optional) ─────────────────────────────────────
# Provide any EVM JSON-RPC endpoint (Alchemy, Infura, local Hardhat, etc.)
ETHEREUM_RPC_URL=

# ── Push notifications (optional) ────────────────────────────────────────────
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_ACCESS_TOKEN=

# ── Email (optional) ─────────────────────────────────────────────────────────
# Standard SMTP URL, e.g. smtp://user:pass@smtp.example.com:587
SMTP_URL=
MAIL_FROM=PocketBank <no-reply@pocketbank.local>

# ── Merchant QR endpoint (optional) ──────────────────────────────────────────
MERCHANT_API_KEY=

# ── Background scheduler ──────────────────────────────────────────────────────
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=60000

# ── Misc ──────────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
SAVINGS_APY=0.02
LOG_LEVEL=info
